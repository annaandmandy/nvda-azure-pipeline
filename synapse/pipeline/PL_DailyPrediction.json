{
	"name": "PL_DailyPrediction",
	"properties": {
		"activities": [
			{
				"name": "RunBlobStreamPredict",
				"type": "SynapseNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "BlobStreamPredict",
						"type": "NotebookReference"
					},
					"parameters": {
						"TEST_SESSION_DATE": {
							"value": {
