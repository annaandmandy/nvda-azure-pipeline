								"type": "Expression"
							},
							"type": "string"
						}
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparkNVDA",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"driverSize": "Small"
				}
			}
		],
		"parameters": {
			"p_session_date": {
				"type": "string",
				"defaultValue": ""
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-16T04:28:26Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}
