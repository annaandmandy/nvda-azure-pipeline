				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"daily_prediction_df = (\n",
					"    daily_prediction_df\n",
					"    .withColumn(\n",
					"        \"prediction_generated_at_utc\",\n",
					"        F.current_timestamp()\n",
					"    )\n",
					"    .withColumn(\n",
					"        \"model_version\",\n",
					"        F.lit(\"nvda_volume_rf_v1\")\n",
					"    )\n",
					"    .withColumn(\n",
					"        \"prediction_cutoff\",\n",
					"        F.lit(\"06:00 America/New_York\")\n",
					"    )\n",
					")\n",
					"\n",
					"display(daily_prediction_df)"
				],
				"execution_count": 23
