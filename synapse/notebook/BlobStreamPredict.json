		"cells": [
			{
				"cell_type": "code",
				"source": [
					"from datetime import datetime, timezone\n",
					"from zoneinfo import ZoneInfo\n",
					"\n",
					"from pyspark.sql import functions as F\n",
					"from pyspark.ml import PipelineModel\n",
					"\n",
					"ET = ZoneInfo(\"America/New_York\")\n",
					"\n",
					"STORAGE_ACCOUNT = \"stnvdaanna2026\"\n",
					"\n",
					"STREAM_ROOT = (\n",
					"    f\"abfss://gold@{STORAGE_ACCOUNT}.dfs.core.windows.net/stream\"\n",
					")\n",
					"\n",
					"MODEL_PATH = (\n",
					"    f\"abfss://gold@{STORAGE_ACCOUNT}.dfs.core.windows.net/\"\n",
					"    \"models/nvda_volume_rf/\"\n",
					")\n",
					"\n",
					"PREDICTION_ROOT = (\n",
					"    f\"abfss://gold@{STORAGE_ACCOUNT}.dfs.core.windows.net/\"\n",
					"    \"prediction/streaming/\"\n",
					")\n",
					"\n",
					"print(\"STREAM_ROOT:\", STREAM_ROOT)\n",
					"print(\"MODEL_PATH:\", MODEL_PATH)\n",
					"print(\"PREDICTION_ROOT:\", PREDICTION_ROOT)"
				],
				"execution_count": 12
			},
			{
				"cell_type": "code",
				"metadata": {
					"tags": [
						"parameters"
					]
				},
				"source": [
					"TEST_SESSION_DATE = \"\""
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"tags": []
				},
				"source": [
					"\n",
					"yyyy, mm, dd = TEST_SESSION_DATE.split(\"-\")\n",
					"\n",
					"input_path = (\n",
					"    f\"{STREAM_ROOT}/{yyyy}/{mm}/{dd}/tweets_gold.json\"\n",
					")\n",
					"\n",
					"print(\"Reading:\", input_path)\n",
					"\n",
					"raw_stream_df = (\n",
					"    spark.read\n",
					"    .option(\"multiline\", \"true\")\n",
					"    .json(input_path)\n",
					")\n",
					"\n",
					"raw_stream_df.printSchema()"
				],
				"execution_count": 13
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"streaming_df = (\n",
					"    raw_stream_df\n",
					"    .select(\n",
					"        F.explode(\"tweets\").alias(\"tweet\")\n",
					"    )\n",
					"    .select(\"tweet.*\")\n",
					")\n",
					"\n",
					"print(\"Tweet rows:\", streaming_df.count())\n",
					"\n",
					"streaming_df.printSchema()\n",
					"\n",
					"display(streaming_df.limit(5))"
				],
				"execution_count": 14
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F\n",
					"\n",
					"stream_features_df = (\n",
					"    streaming_df\n",
					"\n",
					"    # candidate session -> actual prediction session\n",
					"    # 2026-09-16 is a Wednesday / NYSE trading day,\n",
					"    # so for this live test it remains 2026-09-16.\n",
					"    .withColumn(\n",
					"        \"prediction_session_date\",\n",
					"        F.to_date(\"candidate_prediction_session_date\")\n",
					"    )\n",
					"\n",
					"    # Same calendar features used during training\n",
					"    .withColumn(\n",
					"        \"day_of_week\",\n",
					"        F.date_format(\"prediction_session_date\", \"EEEE\")\n",
					"    )\n",
					"\n",
					"    .withColumn(\n",
					"        \"is_weekend\",\n",
					"        F.dayofweek(\"prediction_session_date\").isin([1, 7])\n",
					"    )\n",
					")"
				],
				"execution_count": 15
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"display(\n",
					"    stream_features_df.select(\n",
					"        \"tweet_id\",\n",
					"        \"tweet_timestamp_et\",\n",
					"        \"candidate_prediction_session_date\",\n",
					"        \"prediction_session_date\",\n",
					"        \"day_of_week\",\n",
					"        \"is_weekend\",\n",
					"        \"sentiment_score\",\n",
					"        \"interaction_score\",\n",
					"        \"credibility_score\"\n",
					"    )\n",
					")"
				],
				"execution_count": 16
			},
			{
				"cell_type": "code",
				"source": [
					"numeric_features = [\n",
					"    \"sentiment_score\",\n",
					"    \"interaction_score\",\n",
					"    \"favorite_ratio\",\n",
					"    \"reply_ratio\",\n",
					"    \"followers_count\",\n",
					"    \"friends_count\",\n",
					"    \"media_count\",\n",
					"    \"account_age_days\",\n",
					"    \"credibility_score\"\n",
					"]\n",
					"\n",
					"boolean_features = [\n",
					"    \"is_viral\",\n",
					"    \"is_blue_verified\",\n",
					"    \"is_new_account\",\n",
					"    \"is_influencer\",\n",
					"    \"is_weekend\"\n",
					"]\n",
					"\n",
					"categorical_features = [\n",
					"    \"day_of_week\"\n",
					"]"
				],
				"execution_count": 17
			},
			{
				"cell_type": "code",
				"source": [
					"numeric_features = [\n",
					"    \"sentiment_score\",\n",
					"    \"interaction_score\",\n",
					"    \"favorite_ratio\",\n",
					"    \"reply_ratio\",\n",
					"    \"followers_count\",\n",
					"    \"friends_count\",\n",
					"    \"media_count\",\n",
					"    \"account_age_days\",\n",
					"    \"credibility_score\"\n",
					"]\n",
					"\n",
					"boolean_features = [\n",
					"    \"is_viral\",\n",
					"    \"is_blue_verified\",\n",
					"    \"is_new_account\",\n",
					"    \"is_influencer\",\n",
					"    \"is_weekend\"\n",
					"]\n",
					"\n",
					"for col_name in numeric_features:\n",
					"    stream_features_df = stream_features_df.withColumn(\n",
					"        col_name,\n",
					"        F.coalesce(\n",
					"            F.col(col_name).cast(\"double\"),\n",
					"            F.lit(0.0)\n",
					"        )\n",
					"    )\n",
					"\n",
					"for col_name in boolean_features:\n",
					"    stream_features_df = stream_features_df.withColumn(\n",
					"        col_name,\n",
					"        F.coalesce(\n",
					"            F.col(col_name).cast(\"boolean\"),\n",
					"            F.lit(False)\n",
					"        )\n",
					"    )"
				],
				"execution_count": 18
			},
			{
				"cell_type": "code",
				"source": [
					"check_cols = (\n",
					"    numeric_features\n",
					"    + boolean_features\n",
					"    + [\"day_of_week\"]\n",
					")\n",
					"\n",
					"stream_features_df.select([\n",
					"    F.sum(\n",
					"        F.col(c).isNull().cast(\"int\")\n",
					"    ).alias(c)\n",
					"    for c in check_cols\n",
					"]).show(truncate=False)"
				],
				"execution_count": 19
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.ml import PipelineModel\n",
					"\n",
					"print(\"Loading model:\")\n",
					"print(MODEL_PATH)\n",
					"\n",
					"loaded_model = PipelineModel.load(MODEL_PATH)\n",
					"\n",
					"print(\"Model loaded successfully.\")"
				],
				"execution_count": 20
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"predictions_df = loaded_model.transform(\n",
					"    stream_features_df\n",
					")\n",
					"\n",
					"print(\"Prediction rows:\", predictions_df.count())\n",
					"\n",
					"display(\n",
					"    predictions_df.select(\n",
					"        \"tweet_id\",\n",
					"        \"prediction_session_date\",\n",
					"        \"day_of_week\",\n",
					"        \"sentiment_score\",\n",
					"        \"interaction_score\",\n",
					"        \"prediction\"\n",
					"    )\n",
					")"
				],
				"execution_count": 21
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"daily_prediction_df = (\n",
					"    predictions_df\n",
					"    .groupBy(\"prediction_session_date\")\n",
					"    .agg(\n",
					"        F.avg(\"prediction\").alias(\"predicted_next_volume\"),\n",
					"        F.count(\"*\").alias(\"tweet_count\"),\n",
					"        F.avg(\"sentiment_score\").alias(\"avg_sentiment_score\"),\n",
					"        F.avg(\"interaction_score\").alias(\"avg_interaction_score\")\n",
					"    )\n",
					")\n",
					"\n",
					"display(daily_prediction_df)"
